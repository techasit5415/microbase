# ==============================================================================
# Microbase Environment Configuration
# Copy to .env and adjust values for your environment.
# All values can also be overridden via CLI flags (run `./microbase --help`).
# ==============================================================================

# --- Required ---
# PostgreSQL connection string (pgvector extension recommended for vector fields)
DATABASE_URL=postgres://microbase:microbase@localhost:5432/microbase?sslmode=disable

# --- Security (Strongly recommended in production) ---
# Secret key for signing JWT auth tokens (generate with: openssl rand -base64 32)
# If left empty, a random secret is generated on startup (tokens invalidate on restart).
JWT_SECRET=

# --- Server ---
HOST=0.0.0.0
PORT=3000

# Comma-separated list of allowed CORS origins (leave empty to allow all origins)
CORS_ORIGINS=

# Set to true to disable the embedded Admin UI (/_/) for headless API-only mode
DISABLE_ADMIN_UI=false

# Set to true for verbose debug logging
DEV=false

# --- Optional Cache ---
# Leave empty to use built-in In-Memory Cache, or set redis://localhost:6379/0 for Redis
REDIS_URL=

# --- Optional Directories ---
DATA_DIR=./storage
HOOKS_DIR=./mb_hooks
MIGRATIONS_DIR=./mb_migrations
